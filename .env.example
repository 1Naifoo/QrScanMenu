# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Supabase project (shared, multi-tenant) ---
# Public values — safe to expose in the admin panel's client-side bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Secret — used ONLY by the server-side build step (scripts/generate-static.js).
# Never expose this in any frontend bundle or commit it to the repo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Domain / routing ---
# The permanent public domain customers see, e.g. https://yourbrand.com
PUBLIC_SITE_URL=https://yourbrand.com

# --- Admin panel ---
# Where the admin panel itself is hosted (separate from the static customer site).
ADMIN_PANEL_URL=https://admin.yourbrand.com

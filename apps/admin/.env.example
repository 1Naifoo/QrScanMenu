# Copy to apps/admin/.env — Vite only exposes vars prefixed with VITE_
# to the browser bundle. These are the public, safe-to-expose values;
# Row Level Security in Supabase is what actually restricts writes.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

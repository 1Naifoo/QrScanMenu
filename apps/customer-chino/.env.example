# Build-time secrets for THIS client's site. Set these in your host's
# build environment (Vercel/Netlify/GitHub Actions secrets) — never commit
# a real .env, and never expose the service-role key in any browser bundle.
#
# Which restaurant this repo pulls data for is set in client.config.json,
# not here — that's the file you edit per new client, alongside the theme
# colors in the same file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
